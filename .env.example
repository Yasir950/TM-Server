NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Optional TURN relay for huddles; needed when people are behind strict NATs or corporate firewalls
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
# Desktop app installer offered from the logo menu; defaults to public/download/Workchime-Setup.exe
# NEXT_PUBLIC_DESKTOP_APP_URL=https://example.com/Workchime-Setup.exe
# AI summaries (/summarize)
# ANTHROPIC_API_KEY=
# SCIM provisioning at /api/scim/v2/Users (server-only; never expose the service role key to the browser)
# SCIM_TOKEN=
# SUPABASE_SERVICE_ROLE_KEY=
