NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# TURN relay for huddles; needed when people are on different networks, mobile data, or behind firewalls.
# Recommended (free 1,000 GB/month): Cloudflare dashboard → Realtime → TURN Server → Create → copy both values
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# Alternative (free 20 GB/month): metered.ca → TURN Server → app domain + API key
# METERED_TURN_DOMAIN=yourapp.metered.live
# METERED_TURN_API_KEY=
# Or a self-hosted relay (e.g. coturn); these are baked into the browser bundle at build time
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
# Desktop installers offered from the logo menu; default to public/download/. Point them at the GitHub release from .github/workflows/desktop.yml:
# NEXT_PUBLIC_DESKTOP_WIN_URL=https://github.com/OWNER/REPO/releases/download/desktop-latest/Workchime-Setup.exe
# NEXT_PUBLIC_DESKTOP_MAC_URL=https://github.com/OWNER/REPO/releases/download/desktop-latest/Workchime.dmg
# AI summaries (/summarize)
# ANTHROPIC_API_KEY=
# Web Push (messages and calls while the app is closed). Generate keys with: npx web-push generate-vapid-keys
# PUSH_SECRET is any long random string; put the same value in the database's push_config row
# (see supabase/migrations/20261103000000_push_notifications.sql)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# PUSH_SECRET=
# SCIM provisioning at /api/scim/v2/Users (server-only; never expose the service role key to the browser)
# SCIM_TOKEN=
# SUPABASE_SERVICE_ROLE_KEY=
# Email without a domain: Gmail SMTP (about 500 emails/day). Turn on 2-Step Verification for the Gmail account,
# create an app password at https://myaccount.google.com/apppasswords and paste it here. When both are set,
# all app emails go through Gmail and the Resend settings below are ignored. Use the same account in
# Supabase > Authentication > Emails > SMTP Settings (host smtp.gmail.com, port 465) for sign-up/reset emails.
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# Optional: SMTP_HOST (default smtp.gmail.com), SMTP_PORT (default 465), EMAIL_FROM_SMTP=Workchime <you@gmail.com>
# Contact form and upgrade requests (/api/contact) are emailed through Resend (resend.com). Without a key they are
# still saved and listed under Super admin > Requests. onboarding@resend.dev only delivers to your Resend account's
# own email; verify a domain at Resend to send from your own address.
# RESEND_API_KEY=
# CONTACT_EMAIL=368yasir@gmail.com
# CONTACT_FROM=Workchime <hello@your-domain.com>
# Task assignment emails (/api/email/send) also go through Resend, posted by the database like Web Push
# (needs the push_config row and PUSH_SECRET above). Sender address; falls back to CONTACT_FROM:
# EMAIL_FROM=Workchime <notifications@your-domain.com>
